{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vision-JEV run metadata",
  "type": "object",
  "required": ["schema_version", "run_id", "status", "evidence_status", "created_at", "config", "data", "environment"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string"},
    "status": {"enum": ["created", "running", "completed", "failed", "aborted"]},
    "evidence_status": {"enum": ["planned", "structural_check", "measured", "reproduced", "released"]},
    "created_at": {"type": "string", "format": "date-time"},
    "config": {"type": "object", "required": ["path", "sha256"]},
    "data": {"type": "object", "required": ["path", "sha256"]},
    "environment": {"type": "object"}
  }
}
